{
  "name": "migration-kit",
  "version": "0.0.1",
  "description": "Building project-specific migration runners.",
  "keywords": [
    "ast-grep",
    "codemod",
    "jscodeshift",
    "migration"
  ],
  "license": "MIT",
  "author": "Yein Sung",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "log-update": "^8.0.0",
    "semver": "^7.8.1",
    "tinyglobby": "^0.2.16",
    "tinyrainbow": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/semver": "^7.7.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "ast-grep": "^0.1",
    "comorph": "^0.2 || ^0.3",
    "jscodeshift": "^17"
  },
  "packageManager": "pnpm@11.23.0"
}
